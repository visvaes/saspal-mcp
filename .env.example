# Copy this file to .env and add your own secret locally.
OPENROUTER_API_KEY=

# Optional; defaults to the model configured by the application.
OPENROUTER_MODEL=

# Password-reset email uses SMTP, separate from Gmail OAuth and sending.
APP_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Set true when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
